---
// Wspólny szkielet stron: <head> (meta, OG, kanoniczny adres, fonty, JSON-LD), nagłówek, treść i stopka.
// Skrypt w <head> ustawia skalę strony na komputerze (--page-zoom), zanim cokolwiek się narysuje.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { LcpImage } from '../lib/lcp';
import { siteNodes, pageNode, stripContext } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  current?: string;
  footerEdge?: string;
  /** Obraz LCP pierwszego ekranu (srcset z getImage). Preload na samym początku <head>, przed wklejonym CSS,
      żeby przeglądarka zaczęła go pobierać z pierwszym pakietem HTML. */
  lcpImage?: LcpImage;
  /** Typ strony w schema.org (domyślnie WebPage), np. CollectionPage dla archiwów. */
  pageType?: string;
  /** O czym jest strona (węzeł albo {'@id': ...}), np. wydarzenie na stronie głównej. */
  about?: object;
  /** Strona bez indeksowania (np. 404). */
  noindex?: boolean;
}
const { title, description, image = '/og.jpg', jsonLd, current, footerEdge = 'var(--bg)', lcpImage, pageType, about, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Cross Straceńców') ? title : `${title} | Cross Straceńców Głogów`;
const site = Astro.site!.href.replace(/\/$/, '');
const ogImage = new URL(image, Astro.site).href;
// Jeden graf JSON-LD na stronę: organizator i serwis (wspólne), bieżąca strona i dane przekazane przez stronę.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteNodes(site),
    pageNode(site, { url: canonical.href, title: fullTitle, description, type: pageType, image: ogImage, about }),
    ...stripContext([jsonLd ?? []].flat()),
  ],
};
---

<!doctype html>
<html lang="pl" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {lcpImage && <link rel="preload" as="image" type={lcpImage.type} imagesrcset={lcpImage.srcset} imagesizes={lcpImage.sizes} fetchpriority="high" />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#181817" />
    <meta name="geo.region" content="PL-DS" />
    <meta name="geo.placename" content="Głogów" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Cross Straceńców" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === '/og.jpg' && <><meta property="og:image:type" content="image/jpeg" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta property="og:image:alt" content="Biegacze na trasie Crossu Straceńców w Głogowie" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" title="Opis dla agentów AI" href="/llms.txt" />
    {/* Dwa fonty z pierwszego ekranu: tytuł (Anton) i tekst (Barlow). Reszta dociąga się sama. */}
    <link rel="preload" href="/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>
      // Skala strony na komputerze (od 1024px), dobierana do okna przeglądarki, nie do jednego laptopa.
      // Wzorzec: okno około 1440 x 810 px wygląda w 100%. Niższe albo węższe okna (laptopy 1366 x 768, 1536 x 864
      // ze skalowaniem 125%) dostają mniej, do 85%. Szerokie monitory (1440p, 4K) dostają więcej, do 130%,
      // żeby treść nie była wąskim paskiem na środku. Telefony i tablety w pionie zostają w 100%.
      (() => {
        const d = document.documentElement;
        const desktop = matchMedia('(min-width: 1024px)');
        let frame = 0;
        const fit = () => {
          frame = 0;
          // Na telefonie nic nie liczymy: matchMedia nie wymusza przeliczenia układu strony, a innerWidth tak.
          if (!desktop.matches) return d.style.getPropertyValue('--page-zoom') && d.style.removeProperty('--page-zoom');
          const w = innerWidth, h = innerHeight;
          const byW = w < 1440 ? w / 1440 : w > 2200 ? w / 2200 : 1;
          const z = Math.min(1.3, Math.max(0.85, Math.min(byW, h / 810)));
          d.style.setProperty('--page-zoom', z.toFixed(3));
        };
        fit();
        addEventListener('resize', () => { if (!frame) frame = requestAnimationFrame(fit); });
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg">
    <a href="#tresc" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] btn btn-secondary">Przejdź do treści</a>
    <Header current={current} />
    <main id="tresc">
      <slot />
    </main>
    <Footer edgeFrom={footerEdge} />
  </body>
</html>
