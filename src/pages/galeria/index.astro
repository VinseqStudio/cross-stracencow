---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { photosOf } from '../../lib/photos';
import { editions } from '../../../db/data/editions';

// Wszystkie edycje, od najnowszej. Rok bez zdjęć dostaje pustą ramkę, dopóki nie dojdą pliki.
const years = await Promise.all(
  [...editions].reverse().map(async (e) => ({
    ...e,
    photos: await Promise.all(
      photosOf(e.year).map(async ({ img }, i) => {
        const full = await getImage({ src: img, width: Math.min(img.width, 1600), format: 'webp', quality: 82 });
        return { img, full, alt: `Cross Straceńców ${e.year}, zdjęcie ${i + 1}` };
      }),
    ),
  })),
);
const count = years.reduce((s, y) => s + y.photos.length, 0);
---

<Base
  title="Galeria"
  description={`Zdjęcia z ${years.length} edycji Crossu Straceńców w Głogowie, od 2011 roku: rowy z wodą, błoto, meta i biegi dzieci.`}
  current="galeria"
>
  <section class="bg-bg pt-12 pb-8 lg:pt-20 lg:pb-12" aria-labelledby="galeria-h1">
    <div class="wrap grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
      <h1 id="galeria-h1" class="display-xl">Galeria</h1>
      <p class="lead max-w-[44ch] text-muted">{years.length} edycji, {count} zdjęć. Dotknij zdjęcia, żeby je powiększyć.</p>
    </div>
  </section>

  <nav aria-label="Lata" class="sticky top-16 z-40 border-y border-line bg-bg/95 backdrop-blur-sm lg:top-[72px]">
    <ul class="wrap flex gap-2 overflow-x-auto py-3 [scrollbar-width:none]">
      {years.map((y) => (
        <li class="shrink-0"><a href={`#rok-${y.year}`} class="inline-flex min-h-11 items-center rounded-sm border border-line-strong px-4 font-condensed text-lg font-semibold tabular-nums hover:border-fg">{y.year}</a></li>
      ))}
    </ul>
  </nav>

  <div class="pswp-gallery bg-bg">
    {years.map((y) => (
      <section id={`rok-${y.year}`} class="scroll-mt-36 border-b border-line py-12 lg:py-16" aria-labelledby={`rok-${y.year}-h`}>
        <div class="wrap grid gap-6">
          <h2 id={`rok-${y.year}-h`} class="display-lg">
            {y.year} <span class="text-muted">{y.number} edycja</span>
          </h2>
          {y.photos.length ? (
            <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4">
              {y.photos.map((p) => (
                <li>
                  <a
                    href={p.full.src}
                    data-pswp-width={p.full.attributes.width}
                    data-pswp-height={p.full.attributes.height}
                    class="photo-zoom block aspect-[3/2]"
                    aria-label={`Powiększ: ${p.alt}`}
                  >
                    <Picture
                      src={p.img}
                      alt={p.alt}
                      widths={[300, 480, 640]}
                      sizes="(min-width: 1024px) 310px, (min-width: 640px) 33vw, 50vw"
                      formats={['avif', 'webp']}
                      class="size-full object-cover"
                    />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
              <div class="col-span-2 grid aspect-[3/2] place-items-center bg-surface sm:aspect-[3/1] sm:col-span-4">
                <p class="text-center">
                  <span class="block font-display text-[clamp(72px,12vw,160px)] leading-none text-line-strong">{y.number}</span>
                  <span class="mt-2 block text-[15px] text-muted">Zdjęcia z tej edycji pojawią się wkrótce.</span>
                </p>
              </div>
            </div>
          )}
        </div>
      </section>
    ))}
  </div>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // Każdy rok to osobny album: strzałki przechodzą tylko po zdjęciach z tej samej edycji.
  document.querySelectorAll<HTMLElement>('.pswp-gallery section').forEach((section) => {
    if (!section.querySelector('a[data-pswp-width]')) return;
    const lightbox = new PhotoSwipeLightbox({
      gallery: section,
      children: 'a[data-pswp-width]',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.94,
      showHideAnimationType: 'zoom',
      closeTitle: 'Zamknij',
      zoomTitle: 'Powiększ',
      arrowPrevTitle: 'Poprzednie',
      arrowNextTitle: 'Następne',
      errorMsg: 'Nie udało się wczytać zdjęcia.',
    });
    lightbox.init();
  });
</script>
