---
import { ArrowRight } from '@lucide/astro';
import { db, Edition, Result, desc, count } from 'astro:db';
import Base from '../../layouts/Base.astro';

const editions = await db.select().from(Edition).orderBy(desc(Edition.year));
const counts = new Map(
  (await db.select({ year: Result.year, n: count() }).from(Result).groupBy(Result.year)).map((r) => [r.year, r.n]),
);
const fmt = (iso?: string | null) =>
  iso ? new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso)) : null;
---

<Base title="Wyniki" description={`Wyniki wszystkich ${editions.length} edycji Crossu Straceńców w Głogowie, od 2011 roku: biegi główne, sztafety i biegi dzieci.`} current="wyniki">
  <section class="bg-bg pt-12 pb-16 lg:pt-20 lg:pb-24" aria-labelledby="wyniki-h1">
    <div class="wrap grid gap-10 lg:gap-12">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
        <h1 id="wyniki-h1" class="display-xl">Wyniki</h1>
        <p class="lead max-w-[44ch] text-muted">{editions.length} edycji od 2011 roku. Wybierz rok, żeby zobaczyć pełne tabele.</p>
      </div>

      <ul class="grid border-t border-line md:grid-cols-2 md:gap-x-6">
        {editions.map((e) => {
          const n = counts.get(e.year);
          return (
            <li class="border-b border-line">
              <a href={`/wyniki/${e.year}/`} class="group grid grid-cols-[auto_1fr_auto] items-center gap-x-5 py-5 sm:grid-cols-[110px_1fr_auto]">
                <span class="font-display text-[40px] leading-none tabular-nums">{e.year}</span>
                <span class="grid">
                  <span class="font-condensed text-xl leading-tight font-bold">{e.number} edycja</span>
                  <span class="text-[15px] text-muted">
                    {n ? `${n} osób na mecie${fmt(e.date) ? `, ${fmt(e.date)}` : ''}` : 'Tabele w przygotowaniu'}
                  </span>
                </span>
                <span class="grid size-11 place-items-center rounded-sm border border-line-strong transition-colors group-hover:border-fg group-hover:bg-fg group-hover:text-bg">
                  <ArrowRight class="size-5" aria-hidden="true" stroke-linecap="square" />
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Base>
