---
// Archiwum wyników: nagłówek (kolaż, zwycięzcy ostatniej edycji), pasek lat i kafle „Wybierz rok”.
import { Picture } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import { db, Edition } from 'astro:db';
import Base from '../../layouts/Base.astro';
import { lcpPreload } from '../../lib/lcp';
import { breadcrumbs } from '../../lib/seo';
import YearNav from '../../components/YearNav.astro';
import { photo } from '../../lib/photos';
import { winnersOf, yearsWithResults, yearPhoto } from '../../lib/results';

const years = await yearsWithResults();
const latest = years[0].year;
const winners = await winnersOf(latest);
const dates = new Map((await db.select().from(Edition)).map((e) => [e.year, e.date]));
const fmt = (iso?: string | null) =>
  iso ? new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long' }).format(new Date(iso)) : null;
const total = years.reduce((s, y) => s + y.n, 0);

// Kolaż w tle nagłówka, jak w galerii: kadry z mety i trasy z lat, które mają wyniki.
// Pierwszy (największy) kafel kolażu to LCP strony: ten sam obraz idzie do preloadu w <head>.
const COLLAGE_WIDTHS = [360, 600, 900];
const COLLAGE_SIZES = '(min-width: 1024px) 40vw, 66vw';
const collage = [
  { rel: '2025/2025-09.jpg', cls: 'col-span-2 row-span-2' },
  { rel: '2022/2022-13.jpg', cls: '' },
  { rel: '2024/2024-10.jpg', cls: '' },
  { rel: '2023/2023-08.jpg', cls: 'hidden lg:block' },
  { rel: '2025/2025-08.jpg', cls: 'hidden lg:block' },
  { rel: '2022/2022-12.jpg', cls: 'hidden lg:block' },
  { rel: '2024/2024-05.jpg', cls: 'hidden lg:block' },
];
// Dane strukturalne: okruszki (Google pokazuje ścieżkę w wynikach) i opis kolekcji.
const site = Astro.site!.href.replace(/\/$/, '');
// Dane strukturalne: okruszki i lista lat z wynikami (każdy rok to osobny zbiór danych na stronie roku).
const jsonLd = [
  breadcrumbs(site, [['Cross Straceńców', '/'], ['Wyniki', '/wyniki/']]),
  {
    '@type': 'ItemList',
    '@id': `${site}/wyniki/#lata`,
    name: 'Wyniki Crossu Straceńców według lat',
    numberOfItems: years.length,
    itemListElement: years.map((y, i) => ({ '@type': 'ListItem', position: i + 1, name: `Wyniki ${y.year} (${y.n} osób na mecie)`, url: `${site}/wyniki/${y.year}/` })),
  },
];
const lcpImage = await lcpPreload(photo(collage[0].rel), COLLAGE_WIDTHS, COLLAGE_SIZES);
---

<Base title="Wyniki" description={`Wyniki Crossu Straceńców w Głogowie z lat ${years.at(-1)!.year}–${latest}: biegi Złoty, Srebrny i Miedziowy oraz sztafety. ${total} osób na mecie.`} current="wyniki" jsonLd={jsonLd} lcpImage={lcpImage} pageType="CollectionPage">
  <section class="results-hero relative isolate overflow-hidden bg-bg text-fg grain" data-theme="dark" aria-labelledby="wyniki-h1">
    {/* Kafle ukryte na telefonie (hidden lg:block) mają loading="lazy": przeglądarka nie pobiera ich, dopóki są niewidoczne. */}
    <div class="absolute inset-0 -z-10 grid auto-rows-fr grid-cols-3 gap-1 lg:grid-cols-5" aria-hidden="true">
      {collage.map((c, i) => (
        <div class:list={['collage-tile overflow-hidden', c.cls]} style={`--i:${i}`}>
          <Picture src={photo(c.rel)} alt="" widths={COLLAGE_WIDTHS} sizes={COLLAGE_SIZES} formats={['avif', 'webp']} loading={c.cls.includes('hidden') ? 'lazy' : 'eager'} fetchpriority={i === 0 ? 'high' : 'auto'} class="size-full object-cover saturate-[.8]" />
        </div>
      ))}
      <div class="absolute inset-0 bg-[linear-gradient(0deg,#121211_0%,rgba(18,18,17,0.78)_40%,rgba(18,18,17,0.45)_100%)]"></div>
    </div>
    <div class="wrap grid gap-6 pt-10 pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-6 lg:pt-28 lg:pb-16">
      <div class="grid gap-3 lg:gap-5">
        <p class="eyebrow" data-enter style="--i:0">Archiwum, {years.at(-1)!.year}–{latest}</p>
        <h1 id="wyniki-h1" class="font-display text-[clamp(72px,18vw,160px)] leading-[0.8] uppercase lg:text-[min(11vw,172px)]" data-enter style="--i:1">Wyniki</h1>
        <span class="trail hidden w-40 lg:block" data-enter style="--i:2"></span>
        <p class="max-w-[36ch] text-[17px] leading-[26px] text-fg/85 lg:text-[20px] lg:leading-[30px]" data-enter style="--i:3">Pełne tabele z ostatnich {years.length} lat. {total} osób, które dobiegły do mety.</p>
      </div>
      <div class="grid gap-3" data-enter style="--i:4">
        <p class="font-condensed text-[15px] font-bold tracking-[0.06em] text-accent uppercase">Zwycięzcy {latest}</p>
        <ul class="grid gap-px overflow-hidden rounded-sm bg-fg/15 sm:grid-cols-3">
          {winners.map((w) => (
            <li class="grid content-start gap-2 bg-bg/80 px-4 py-3 backdrop-blur-sm sm:gap-4 sm:p-5">
              <span class="font-condensed text-[16px] leading-tight font-bold sm:text-lg">{w.race}</span>
              <span class="grid grid-cols-2 gap-3 sm:grid-cols-1 sm:gap-4">
                {[w.man, w.woman].filter(Boolean).map((r) => (
                  <span class="grid gap-0.5">
                    <span class="font-display text-[24px] leading-none tabular-nums sm:text-[36px]">{r!.time}</span>
                    <span class="truncate text-[14px] leading-5 font-semibold sm:text-[15px]">{r!.name}</span>
                  </span>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <YearNav label="Wyniki z lat" years={years.map((y) => ({ year: y.year, href: `/wyniki/${y.year}/` }))} />

  <section class="section-pad bg-bg" aria-labelledby="lata-h">
    <div class="wrap grid gap-8">
      <h2 id="lata-h" class="display-lg">Wybierz rok</h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {years.map((y) => (
          <li>
            <a href={`/wyniki/${y.year}/`} class="group relative isolate grid aspect-[4/5] content-end overflow-hidden rounded-sm p-5 text-fg" data-theme="dark">
              {yearPhoto[y.year] && (
                <Picture src={photo(yearPhoto[y.year].rel)} alt="" widths={[360, 600]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw" formats={['avif', 'webp']} class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]" />
              )}
              <span class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgba(18,18,17,0.92)_0%,rgba(18,18,17,0.2)_65%)]"></span>
              <span class="font-display text-[80px] leading-[0.85] tabular-nums">{y.year}</span>
              <span class="mt-3 flex items-end justify-between gap-3">
                <span class="text-[15px] leading-5">{y.n} osób na mecie{fmt(dates.get(y.year)) ? `, ${fmt(dates.get(y.year))}` : ''}</span>
                <span class="grid size-11 shrink-0 place-items-center rounded-sm bg-fg text-bg transition-transform group-hover:translate-x-1"><ArrowRight class="size-5" aria-hidden="true" stroke-linecap="square" /></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Tekst nagłówka rusza razem z kafelkami, nie po nich: szybciej widać tytuł (LCP). */
  .results-hero { --enter-start: 0.1s; }
</style>

{/* Wejście nagłówka (kafle kolażu po kolei, potem tekst i zwycięzcy) jest w CSS: global.css, [data-enter] i .collage-tile. */}
