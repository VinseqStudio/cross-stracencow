---
// Wyniki jednej edycji: nagłówek ze zwycięzcami, pasek lat, przełącznik biegów, wyszukiwarka i pełne tabele.
// Strony powstają dla każdego roku z wynikami w Astro DB. Ten sam rok jako JSON: /wyniki/<rok>.json.
import { Picture } from 'astro:assets';
import { ArrowLeft, Search } from '@lucide/astro';
import { db, Edition, eq } from 'astro:db';
import Base from '../../layouts/Base.astro';
import { lcpPreload } from '../../lib/lcp';
import { breadcrumbs, ids } from '../../lib/seo';
import YearNav from '../../components/YearNav.astro';
import { photo } from '../../lib/photos';
import { resultsOf, winnersOf, yearsWithResults, yearPhoto } from '../../lib/results';

export async function getStaticPaths() {
  return (await yearsWithResults()).map(({ year }) => ({ params: { year: String(year) } }));
}

const year = Number(Astro.params.year);
const [edition] = await db.select().from(Edition).where(eq(Edition.year, year));
const { rows, races } = await resultsOf(year);
const winners = await winnersOf(year);
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const date = edition.date
  ? new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(edition.date))
  : null;
const bg = yearPhoto[year];
// Zdjęcie w tle nagłówka to LCP strony: preload w <head> z tymi samymi ustawieniami co <Picture> niżej.
const BG_WIDTHS = [600, 1000, 1350];
const lcpImage = bg ? await lcpPreload(photo(bg.rel), BG_WIDTHS, '100vw') : undefined;
const allYears = await yearsWithResults();

const site = Astro.site!.href.replace(/\/$/, '');
// Dane strukturalne: tabela wyników jako zbiór danych (Google Dataset Search, agenci AI) z plikiem JSON i okruszki.
const jsonLd = [{
  '@type': 'Dataset',
  '@id': `${site}/wyniki/${year}/#wyniki`,
  name: `Wyniki Crossu Straceńców ${year}`,
  description: `Pełne wyniki ${edition.number ?? ''} edycji Crossu Straceńców w Głogowie (${year}): ${races.join(', ')}. ${rows.length} osób na mecie: miejsce, numer startowy, imię i nazwisko, klub, kategoria i czas.`.replace('  ', ' '),
  url: `${site}/wyniki/${year}/`,
  inLanguage: 'pl-PL',
  isAccessibleForFree: true,
  keywords: ['Cross Straceńców', 'wyniki biegu', 'bieg przełajowy', 'Głogów', String(year)],
  temporalCoverage: edition.date ?? String(year),
  spatialCoverage: { '@type': 'Place', name: 'Tor motocrossowy Górków, Głogów' },
  creator: { '@id': ids(site).organizer },
  isPartOf: { '@id': ids(site).website },
  distribution: { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${site}/wyniki/${year}.json` },
}, breadcrumbs(site, [['Cross Straceńców', '/'], ['Wyniki', '/wyniki/'], [String(year), `/wyniki/${year}/`]])];
---

<Base
  title={`Wyniki ${year}`}
  description={`Wyniki Crossu Straceńców w Głogowie (${year}): ${races.join(', ')}. ${rows.length} osób na mecie.`}
  current="wyniki"
  jsonLd={jsonLd}
  lcpImage={lcpImage}
>
  <link slot="head" rel="alternate" type="application/json" title={`Wyniki ${year} (JSON)`} href={`/wyniki/${year}.json`} />
  <section class="year-hero relative isolate overflow-hidden bg-bg text-fg grain" data-theme="dark" aria-labelledby="rok-h1">
    {bg && (
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <Picture src={photo(bg.rel)} alt="" widths={BG_WIDTHS} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="size-full object-cover opacity-40 saturate-[.8]" />
        <div class="absolute inset-0 bg-[linear-gradient(0deg,#121211_0%,rgba(18,18,17,0.55)_50%,rgba(18,18,17,0.3)_100%)]"></div>
      </div>
    )}
    <div class="wrap grid gap-10 pt-12 pb-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-6 lg:pt-20 lg:pb-16">
      <div class="grid justify-items-start gap-5">
        <a href="/wyniki/" data-enter style="--i:0" class="link-draw inline-flex min-h-11 items-center gap-2 font-condensed text-[17px] font-semibold"><ArrowLeft class="size-4" aria-hidden="true" stroke-linecap="square" /> Wszystkie lata</a>
        <p class="eyebrow" data-enter style="--i:1">{edition.number} edycja</p>
        <h1 id="rok-h1" class="font-display text-[clamp(96px,20vw,180px)] leading-[0.8] tabular-nums lg:text-[min(12vw,190px)]" data-enter style="--i:2">{year}</h1>
        <p class="lead text-fg/85" data-enter style="--i:3">{date ?? year}. {rows.length} osób na mecie w {races.length} biegach.</p>
      </div>
      <ul class="grid gap-px overflow-hidden rounded-sm bg-fg/15 sm:grid-cols-3" data-enter style="--i:4">
        {winners.map((w) => (
          <li class="grid content-start gap-4 bg-bg/80 p-5 backdrop-blur-sm">
            <span class="font-condensed text-lg leading-tight font-bold">{w.race}</span>
            {[w.man, w.woman].filter(Boolean).map((r) => (
              <span class="grid gap-0.5">
                <span class="font-display text-[36px] leading-none tabular-nums">{r!.time}</span>
                <span class="text-[15px] leading-5 font-semibold">{r!.name}</span>
              </span>
            ))}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <YearNav label="Wyniki z lat" current={year} sticky={false} years={allYears.map((y) => ({ year: y.year, href: `/wyniki/${y.year}/` }))} />

  <div class="sticky top-16 z-40 border-b border-line bg-bg/95 backdrop-blur-sm lg:top-[72px]">
    <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-3 py-3 md:grid-cols-[minmax(0,1fr)_320px] md:items-center">
      <nav aria-label="Biegi" class="min-w-0">
        <ul class="flex gap-2 overflow-x-auto [scrollbar-width:none]">
          {races.map((r) => (
            <li class="shrink-0"><a href={`#${slug(r)}`} class="inline-flex min-h-11 items-center rounded-sm border border-line-strong px-4 font-condensed text-[17px] font-semibold whitespace-nowrap hover:border-fg">{r}</a></li>
          ))}
        </ul>
      </nav>
      <label class="relative block">
        <span class="sr-only">Szukaj zawodnika, miasta lub klubu</span>
        <Search class="pointer-events-none absolute top-1/2 left-3 size-5 -translate-y-1/2 text-muted" aria-hidden="true" stroke-linecap="square" />
        <input
          type="search"
          data-filter
          placeholder="Szukaj nazwiska, miasta, klubu"
          class="min-h-12 w-full rounded-sm border-[1.5px] border-line-strong bg-raised py-3 pr-4 pl-10 text-[17px] placeholder:text-muted hover:border-muted focus:border-fg"
        />
      </label>
    </div>
  </div>

  <div class="bg-bg pb-16 lg:pb-24">
    {races.map((race) => {
      const list = rows.filter((r) => r.race === race);
      return (
        <section id={slug(race)} class="race scroll-mt-44 pt-12" aria-labelledby={`${slug(race)}-h`}>
          <div class="wrap grid gap-4">
            <h2 id={`${slug(race)}-h`} class="font-display text-[clamp(32px,4vw,44px)] leading-none uppercase">
              {race} <span class="text-muted">{list.length}</span>
            </h2>
            <table class="w-full border-collapse text-[15px] leading-[22px]">
              <thead class="sr-only sm:not-sr-only">
                <tr class="text-left text-muted">
                  <th scope="col" class="w-16 py-2 pr-3 font-semibold">Miejsce</th>
                  <th scope="col" class="py-2 font-semibold">Zawodnik</th>
                  <th scope="col" class="hidden py-2 font-semibold md:table-cell">Miejscowość</th>
                  <th scope="col" class="hidden py-2 font-semibold lg:table-cell">Klub</th>
                  <th scope="col" class="hidden w-16 py-2 font-semibold sm:table-cell">Kat.</th>
                  <th scope="col" class="w-24 py-2 text-right font-semibold">Czas</th>
                </tr>
              </thead>
              <tbody>
                {list.map((r) => (
                  <tr class="border-t border-line" data-row={`${r.name} ${r.city ?? ''} ${r.club ?? ''}`.toLowerCase()}>
                    <td class:list={['py-3 pr-3 font-display text-xl leading-none tabular-nums', r.place <= 3 ? 'text-accent' : 'text-muted']}>{r.place}</td>
                    <td class="py-3 pr-3">
                      <span class="font-semibold">{r.name}</span>
                      <span class="block text-sm text-muted lg:hidden">{[r.city, r.club].filter(Boolean).join(', ')}</span>
                    </td>
                    <td class="hidden py-3 pr-3 md:table-cell">{r.city}</td>
                    <td class="hidden py-3 pr-3 text-muted lg:table-cell">{r.club}</td>
                    <td class="hidden py-3 text-muted sm:table-cell">{r.category}</td>
                    <td class="py-3 text-right font-condensed text-lg font-bold tabular-nums">{r.time}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="empty hidden py-4 text-muted">Brak wyników dla tego wyszukiwania w tym biegu.</p>
          </div>
        </section>
      );
    })}
  </div>
</Base>

<style>
  /* Wejście nagłówka roku jest w CSS (global.css, [data-enter]); tu rusza od razu, bez kolażu przed nim. */
  .year-hero { --enter-start: 0.05s; }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const races = [...document.querySelectorAll<HTMLElement>('.race')];
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    rows.forEach((r) => (r.hidden = !!q && !r.dataset.row!.includes(q)));
    races.forEach((s) => s.querySelector('.empty')!.classList.toggle('hidden', !q || !!s.querySelector('[data-row]:not([hidden])')));
  });
</script>
