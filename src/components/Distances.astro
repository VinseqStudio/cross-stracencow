---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { distances } from '../data/event';
import { photo } from '../lib/photos';

const levels = ['Na start', 'Spokojnie', 'Wymagająco', 'Twardo', 'Straceńczo'];
const tierVar = { gold: 'var(--medal-gold)', silver: 'var(--medal-silver)', copper: 'var(--medal-copper)' };
---

<section id="dystanse" class="section-pad bg-bg" aria-labelledby="dystanse-title">
  <div class="wrap grid gap-10 lg:gap-12">
    <SectionHead id="dystanse-title" title="Wybierz swoje wyzwanie" lead="Pięć kilometrów, dziesięć albo sztafeta z przyjaciółmi. Na mecie każdy dostaje medal Finisher." />

    <div class="cards grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
      {distances.map((d, i) => (
        <article
          id={`dystans-${d.id}`}
          class:list={['card relative flex flex-col rounded-sm bg-raised', d.first ? 'border-2 border-fg' : 'border border-line']}
          style={`--tier:${tierVar[d.tier]};--i:${i}`}
        >
          {d.first && (
            <span class="absolute top-3 right-3 z-10 rounded-sm bg-red-strong px-2 py-[5px] font-condensed text-[13px] leading-none font-bold tracking-[0.06em] text-on-red uppercase">
              Na pierwszy raz
            </span>
          )}
          <div class="aspect-[16/10] overflow-hidden">
            <Picture
              src={photo(d.photo)}
              alt={d.alt}
              widths={[360, 560, 720]}
              sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw"
              formats={['avif', 'webp']}
              class="size-full object-cover"
            />
          </div>
          <div class="flex flex-1 flex-col gap-3 p-5">
            <div class="flex items-end justify-between gap-3">
              <div class="grid gap-1">
                <h3 class="inline-flex items-center gap-2 font-condensed text-[14px] font-bold tracking-[0.06em] text-muted uppercase">
                  <i class="size-2.5 rounded-full bg-(--tier)" aria-hidden="true"></i>{d.name}
                </h3>
                <p class="font-display text-[44px] leading-[0.95] whitespace-nowrap uppercase lg:text-[clamp(36px,3.3vw,48px)]">{d.distance}</p>
              </div>
              <p class="pb-1 text-right font-display text-[26px] leading-none tabular-nums">{d.price}</p>
            </div>
            <span class="inline-flex items-center gap-2" role="img" aria-label={`Trudność ${d.difficulty} na 5: ${levels[d.difficulty - 1]}`}>
              <span class="inline-flex gap-[3px]" aria-hidden="true">
                {[1, 2, 3, 4, 5].map((n) => (
                  <span class:list={['h-1.5 w-3.5', n <= d.difficulty ? (d.difficulty >= 4 ? 'bg-red' : 'bg-fg') : 'bg-sunken']}></span>
                ))}
              </span>
              <span class="text-[14px] font-semibold" aria-hidden="true">{levels[d.difficulty - 1]}</span>
            </span>
            <p class="text-[15px] leading-[22px]">{d.description}</p>
            <ul class="mt-auto grid border-t border-line text-[14px] leading-5">
              {[...d.facts, { label: 'Limit', value: d.limit }].map((f) => (
                <li class="flex justify-between gap-3 border-b border-line py-2">
                  <span class="text-muted">{f.label}</span><span class="text-right font-semibold">{f.value}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Telefon: karty zatrzymują się pod nagłówkiem i nakładają jedna na drugą. */
  @media (max-width: 639px) {
    .card { position: sticky; top: calc(76px + var(--i) * 12px); transform-origin: 50% 0; }
  }
</style>

<script>
  import { scroll, animate } from 'motion';

  // Karta przykryta przez następną cofa się i lekko przygasa.
  const phone = matchMedia('(max-width: 639px)');
  if (phone.matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cards = [...document.querySelectorAll<HTMLElement>('#dystanse .card')];
    cards.slice(0, -1).forEach((card, i) => {
      scroll(animate(card, { scale: [1, 0.94], filter: ['brightness(1)', 'brightness(0.82)'] }, { ease: 'linear' }), {
        target: cards[i + 1],
        offset: ['start end', `start ${76 + (i + 1) * 12}px`],
      });
    });
  }
</script>
