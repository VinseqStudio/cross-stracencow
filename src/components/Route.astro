---
// Trasa jako odcinki jednej pętli, połączone przerywaną linią z logo.
// Desktop: cztery odcinki w rzędzie, linia biegnie poziomo od numeru do numeru.
// Telefon i tablet: oś trasy w pionie. Zwykłe przewijanie w dół (bez przesuwu w bok, który mylił przy przeciąganiu palcem):
// czerwona linia „biegnie” za kciukiem od numeru do numeru, a numer zapala się, gdy do niego dobiegniesz.
// Bez JS lub przy ograniczonym ruchu cała linia jest od razu narysowana.
import { Picture } from 'astro:assets';
import { chapters } from '../data/event';
import { photo } from '../lib/photos';

const stats = [
  { k: 'Pętla', v: '5 km' },
  { k: 'Teren', v: 'Motocross' },
  { k: 'Przeszkody', v: 'Naturalne' },
];
---

<section id="trasa" class="route section-pad bg-surface" aria-labelledby="trasa-title">
  <div class="wrap grid gap-8 lg:gap-14">
    <header class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-10">
      <div class="grid gap-3">
        <h2 id="trasa-title" class="display-lg">Jedna pętla, pięć kilometrów</h2>
        <p class="lead max-w-[48ch] text-muted">Start i meta na torze motocrossowym. Po drodze piach, trawa, rowy z wodą, błoto i Ściana Płaczu. Na 10 km pokonujesz pętlę dwa razy.</p>
      </div>
      <dl class="grid grid-cols-[auto_auto_auto] justify-start gap-5 whitespace-nowrap sm:gap-6 lg:gap-10">
        {stats.map((x) => <div><dt class="text-[13px] text-muted">{x.k}</dt><dd class="font-display text-[clamp(22px,6.6vw,28px)] leading-none sm:text-[34px] lg:text-[40px]">{x.v}</dd></div>)}
      </dl>
    </header>

    <ol class="stations grid gap-10 sm:gap-12 lg:grid-cols-4 lg:gap-6">
      {chapters.map((c, i) => (
        <li class="station relative grid grid-cols-[44px_minmax(0,1fr)] gap-x-4 sm:gap-x-5 lg:block">
          <div class="station-head relative flex h-11 items-center lg:mb-5" aria-hidden="true">
            <span class:list={['station-badge', i === chapters.length - 1 && 'is-finish']}>{String(i + 1).padStart(2, '0')}</span>
            {i < chapters.length - 1 ? <span class="station-line"></span> : <span class="station-flag"></span>}
          </div>
          <div class="station-body">
            <h3 class="station-title font-condensed text-[24px] leading-[1.1] font-bold">{c.title}</h3>
            <div class="station-photo photo-zoom overflow-hidden rounded-sm">
              <Picture
                src={photo(c.photo)}
                alt={c.alt}
                widths={[360, 560, 720]}
                sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 80vw"
                formats={['avif', 'webp']}
                class="size-full object-cover"
              />
            </div>
            <p class="station-text text-base leading-6 text-muted">{c.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Treść odcinka. Telefon: tytuł na wysokości numeru, pod nim zdjęcie i opis.
     Tablet: zdjęcie z lewej, tytuł i opis z prawej. Desktop: zdjęcie, tytuł, opis w kolumnie. */
  .station-body {
    display: grid;
    grid-template-areas: 'title' 'photo' 'text';
    align-content: start;
  }
  .station-title { grid-area: title; display: flex; align-items: center; min-height: 44px; }
  .station-photo { grid-area: photo; aspect-ratio: 4 / 3; margin-top: 12px; }
  .station-text { grid-area: text; margin-top: 10px; }
  @media (min-width: 640px) and (max-width: 1023px) {
    .station-body { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); grid-template-rows: auto 1fr; grid-template-areas: 'photo title' 'photo text'; column-gap: 24px; }
    .station-photo { margin-top: 0; }
  }
  @media (min-width: 1024px) {
    .station-body { grid-template-areas: 'photo' 'title' 'text'; }
    .station-title { display: block; min-height: 0; margin-top: 20px; }
    .station-photo { aspect-ratio: 4 / 5; margin-top: 0; }
    .station-text { margin-top: 8px; }
  }

  /* Numer odcinka w kwadracie, od niego przerywana linia do następnego numeru. */
  .station-badge {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    background: var(--text);
    color: var(--surface);
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    border-radius: var(--radius-sm);
  }
  .station-badge.is-finish { background: var(--red-strong); color: var(--on-red); }

  /* Desktop: pozioma linia od numeru do numeru, na końcu szachownica mety. */
  .station-line, .station-flag { display: none; }
  @media (min-width: 1024px) {
    .station-line {
      display: block;
      position: absolute;
      top: 50%;
      left: 56px;
      right: -12px;
      height: 5px;
      margin-top: -2.5px;
      background-image: linear-gradient(90deg, var(--red) 0 18px, transparent 18px 100%);
      background-size: 32px 100%;
      transform: skewX(-12deg);
      transform-origin: left center;
    }
    .station-flag {
      display: block;
      position: absolute;
      top: 50%;
      left: 56px;
      width: min(132px, calc(100% - 56px));
      height: 14px;
      margin-top: -7px;
      background-color: var(--surface);
      background-image:
        linear-gradient(45deg, var(--text) 25%, transparent 25%, transparent 75%, var(--text) 75%),
        linear-gradient(45deg, var(--text) 25%, transparent 25%, transparent 75%, var(--text) 75%);
      background-size: 14px 14px;
      background-position: 0 0, 7px 7px;
      transform-origin: left center;
    }
    :global(.js) .route .station-line { transform: skewX(-12deg) scaleX(0); }
    :global(.js) .route .station-flag { transform: scaleX(0); }
    :global(.js) .route .station-badge { opacity: 0; }
  }

  /* Telefon i tablet: pionowa oś. Pod spodem szara przerywana linia (cała trasa),
     na niej czerwona, odsłaniana z przewijaniem (--p od 0 do 1 ustawia skrypt).
     Przycinamy (clip-path), a nie skalujemy: kreski mają stałą długość i czerwone leżą dokładnie na szarych. */
  @media (max-width: 1023px) {
    .station:not(:last-child)::before,
    .station:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 20px;
      top: 52px;
      bottom: -32px;
      width: 4px;
      background-size: 100% 22px;
    }
    .station:not(:last-child)::before { background-image: linear-gradient(180deg, var(--border-strong) 0 12px, transparent 12px 100%); opacity: 0.45; }
    .station:not(:last-child)::after { background-image: linear-gradient(180deg, var(--red) 0 12px, transparent 12px 100%); clip-path: inset(0 0 calc((1 - var(--p, 1)) * 100%) 0); }
    @media (min-width: 640px) { .station:not(:last-child)::before, .station:not(:last-child)::after { bottom: -40px; } }
    /* Za ostatnim numerem oś kończy się szachownicą mety (jak na desktopie), odsłanianą tak samo jak linia. */
    .station:last-child::before {
      content: '';
      position: absolute;
      left: 15px;
      top: 52px;
      height: min(160px, calc(100% - 52px));
      width: 14px;
      background-image:
        linear-gradient(45deg, var(--text) 25%, transparent 25%, transparent 75%, var(--text) 75%),
        linear-gradient(45deg, var(--text) 25%, transparent 25%, transparent 75%, var(--text) 75%);
      background-size: 14px 14px;
      background-position: 0 0, 7px 7px;
      clip-path: inset(0 0 calc((1 - var(--p, 1)) * 100%) 0);
    }

    /* Numer, do którego jeszcze nie dobiegłeś: sam obrys. Po dobiegnięciu wypełnia się i lekko podskakuje. */
    :global(.js) .route .station-badge { transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease; }
    :global(.js) .route .station:not(.is-reached) .station-badge {
      background: var(--surface);
      color: var(--text-muted);
      box-shadow: inset 0 0 0 2px var(--border-strong);
    }
    :global(.js) .route .station.is-reached .station-badge { animation: badge-pop 0.45s var(--ease-out-quint, cubic-bezier(0.22, 1, 0.36, 1)); }
    /* Zdjęcie odcinka wyłania się od dołu, gdy wchodzi na ekran. */
    :global(.js) .route .station-photo { clip-path: inset(18% 0 0 0 round var(--radius-sm)); opacity: 0.4; transition: clip-path 0.7s var(--ease-out-quint, ease-out), opacity 0.7s ease; }
    :global(.js) .route .station.is-seen .station-photo { clip-path: inset(0 0 0 0 round var(--radius-sm)); opacity: 1; }
  }
  @keyframes badge-pop {
    0% { transform: scale(0.8); }
    60% { transform: scale(1.12); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .route .station-badge { opacity: 1; animation: none; }
    :global(.js) .route .station-line { transform: skewX(-12deg); }
    :global(.js) .route .station-flag { transform: none; }
    :global(.js) .route .station-photo { clip-path: none; opacity: 1; transition: none; }
  }
</style>

<script>
  const stations = [...document.querySelectorAll<HTMLElement>('.route .station')];
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const small = matchMedia('(max-width: 1023px)');

  // Telefon i tablet: punkt „biegacza” to 60% wysokości ekranu. Linia między numerami wypełnia się,
  // gdy ten punkt przesuwa się od numeru do następnego; numer zapala się, gdy biegacz go minie.
  // Liczone w każdej klatce przewijania (rAF), więc linia idzie dokładnie za palcem w obie strony.
  if (stations.length) {
    let frame = 0;
    let near = false; // sekcja blisko ekranu: tylko wtedy liczymy przy przewijaniu
    const update = () => {
      frame = 0;
      if (!small.matches || calm.matches) {
        stations.forEach((s) => { s.style.removeProperty('--p'); s.classList.add('is-reached', 'is-seen'); });
        return;
      }
      // Najpierw wszystkie odczyty położenia, potem zapisy (klasy, --p): bez wymuszonego przeliczania układu w pętli.
      const rects = stations.map((s) => s.getBoundingClientRect());
      const runner = innerHeight * 0.6;
      const seenLine = innerHeight * 0.88;
      stations.forEach((s, i) => {
        const r = rects[i];
        const start = r.top + 22; // środek numeru
        // Ostatni odcinek: zamiast linii do następnego numeru szachownica mety (160 px pod numerem).
        const end = rects[i + 1] ? rects[i + 1].top + 22 : start + 30 + Math.min(160, r.height - 52);
        const p = Math.min(1, Math.max(0, (runner - start) / (end - start)));
        s.classList.toggle('is-reached', start < runner);
        if (r.top < seenLine) s.classList.add('is-seen');
        s.style.setProperty('--p', p.toFixed(3));
      });
    };
    const queue = () => { if (near && !frame) frame = requestAnimationFrame(update); };
    new IntersectionObserver(([e]) => { near = e.isIntersecting; if (near) queue(); }, { rootMargin: '50% 0px' })
      .observe(stations[0].parentElement!);
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    small.addEventListener('change', () => { near = true; queue(); });
  }

  // Desktop: linia trasy rysuje się raz, gdy odcinki wchodzą na ekran: numer, odcinek linii, następny numer, na końcu meta.
  const lines = [...document.querySelectorAll<HTMLElement>('.route .station-line')];
  const row = document.querySelector<HTMLElement>('.route .stations');
  let drawn = false;
  const draw = () => {
    if (drawn || !row || !lines.length || calm.matches || small.matches) return;
    drawn = true;
    const step = 200;
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      lines.forEach((el, i) =>
        el.animate({ transform: ['skewX(-12deg) scaleX(0)', 'skewX(-12deg) scaleX(1)'] }, { duration: 500, delay: i * step, fill: 'both' }),
      );
      document.querySelectorAll<HTMLElement>('.route .station-badge').forEach((el, i) =>
        el.animate({ transform: ['scale(0.6)', 'scale(1)'], opacity: [0, 1] }, { duration: 350, delay: i * step, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' }),
      );
      document.querySelector<HTMLElement>('.route .station-flag')
        ?.animate({ transform: ['scaleX(0)', 'scaleX(1)'] }, { duration: 400, delay: step * (lines.length + 0.5), fill: 'both' });
    }, { threshold: 0.15 });
    io.observe(row);
  };
  draw();
  // Strona otwarta wąsko i poszerzona do desktopu: numery są ukryte do animacji, więc ją uruchamiamy.
  small.addEventListener('change', draw);
</script>
