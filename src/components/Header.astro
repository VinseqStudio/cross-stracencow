---
import { Menu, X } from '@lucide/astro';

interface Props { current?: string }
const { current } = Astro.props;

const links = [
  { label: 'Dystanse', href: '/#dystanse' },
  { label: 'Trasa', href: '/#trasa' },
  { label: 'Program', href: '/#program' },
  { label: 'Galeria', href: '/galeria/', id: 'galeria' },
  { label: 'Wyniki', href: '/wyniki/', id: 'wyniki' },
];
---

<header id="top" class="site-header sticky top-0 z-50 border-b border-line bg-bg" data-open="false">
  <div class="wrap flex h-16 items-center justify-between gap-6 lg:h-[72px]">
    <a href="/" class="block shrink-0" aria-label="Cross Straceńców Głogów, strona główna">
      <img src="/logo.webp" alt="" width="68" height="48" class="h-12 w-auto lg:h-14" />
    </a>
    <nav aria-label="Główna" class="hidden lg:block">
      <ul class="flex gap-8">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={l.id && l.id === current ? 'page' : undefined}
              class="link-draw py-2 font-condensed text-[17px] font-semibold tracking-[0.02em] hover:text-accent aria-[current=page]:bg-[length:100%_2px] aria-[current=page]:text-fg"
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <button
      type="button"
      class="menu-toggle -mr-2 grid size-11 place-items-center lg:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Otwórz menu"
    >
      <Menu class="icon-open size-7" stroke-width={2} stroke-linecap="square" aria-hidden="true" />
      <X class="icon-close hidden size-7" stroke-width={2} stroke-linecap="square" aria-hidden="true" />
    </button>
  </div>
  <nav id="menu-mobile" aria-label="Menu" class="menu-panel fixed inset-x-0 top-16 bottom-0 hidden overflow-y-auto bg-bg lg:hidden">
    <ul class="wrap grid pt-2 pb-8">
      {links.map((l) => (
        <li class="border-b border-line">
          <a href={l.href} class="block py-4 font-display text-[40px] leading-none uppercase">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header[data-open='true'] .menu-panel { display: block; }
  .site-header[data-open='true'] .icon-open { display: none; }
  .site-header[data-open='true'] .icon-close { display: block; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const set = (open: boolean) => {
    header.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => set(header.dataset.open !== 'true'));
  header.querySelectorAll('.menu-panel a').forEach((a) => a.addEventListener('click', () => set(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && header.dataset.open === 'true') { set(false); toggle.focus(); } });
  matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && set(false));
</script>
