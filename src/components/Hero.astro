---
import { Picture } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import { photo } from '../lib/photos';
import { event } from '../data/event';

const days = Math.max(0, Math.ceil((new Date(event.dates.start).getTime() - Date.now()) / 864e5));
const facts = [
  { label: 'Edycja', value: `${event.edition}` },
  { label: 'Termin', value: event.dates.label },
  { label: 'Miejsce', value: event.venue.name },
  { label: 'Start za', value: `${days} dni`, countdown: true },
];
---

<section class="hero relative isolate overflow-hidden bg-bg text-fg grain" data-theme="dark" aria-labelledby="hero-title">
  <div class="hero-media absolute inset-x-0 top-0 -z-10 h-[56svh] lg:inset-0 lg:h-auto" aria-hidden="true">
    <Picture
      src={photo('2025/2025-03.jpg')}
      alt=""
      widths={[480, 768, 1080, 1350]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="size-full object-cover object-[52%_60%] saturate-[.85] lg:object-[50%_45%]"
    />
  </div>

  <div class="wrap flex min-h-[calc(100svh-64px)] flex-col justify-end pt-[44svh] pb-8 lg:min-h-[calc(100svh-72px)] lg:pt-32 lg:pb-10">
    <p class="eyebrow mb-3 lg:mb-4" data-enter>Głogów, {event.dates.label}</p>
    <h1 id="hero-title" class="hero-title font-display leading-[0.84] uppercase" data-enter>
      Cross <span class="whitespace-nowrap">Straceńców</span>
    </h1>
    <span class="trail mt-5 w-[min(280px,60%)] origin-left lg:mt-6" data-enter-trail></span>

    <div class="mt-6 grid gap-6 lg:mt-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-12">
      <p class="lead max-w-[46ch] text-fg/90" data-enter>
        <strong class="font-semibold text-fg">Jedyny taki bieg w Polsce.</strong> Pięć albo dziesięć kilometrów przez rowy
        z wodą, błoto i piaszczyste podbiegi toru motocrossowego w Górkowie.
      </p>
      <div class="flex flex-wrap gap-3" data-enter>
        <a href="#dystanse" class="btn btn-secondary min-h-14 grow px-7 sm:grow-0">Zobacz dystanse <ArrowRight aria-hidden="true" stroke-linecap="square" /></a>
        <a href="#trasa" class="btn btn-outline min-h-14 grow border-fg/40 px-7 sm:grow-0">Zobacz trasę</a>
      </div>
    </div>

    <dl class="mt-8 grid grid-cols-2 border-t border-fg/20 lg:mt-10 lg:grid-cols-4" data-enter>
      {facts.map((f, i) => (
        <div class:list={['grid content-start gap-1 py-4 lg:py-5', i % 2 === 0 ? 'pr-4' : 'border-l border-fg/20 pl-4', i >= 2 && 'border-t border-fg/20 lg:border-t-0', 'lg:border-l lg:border-fg/20 lg:px-6 lg:first:border-l-0 lg:first:pl-0']}>
          <dt class="text-[13px] leading-[18px] text-muted">{f.label}</dt>
          <dd class="font-condensed text-[20px] leading-[1.15] font-bold lg:text-[22px]" data-countdown={f.countdown ? event.dates.start : undefined}>{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero-title { font-size: clamp(64px, 17.5vw, 96px); letter-spacing: 0.002em; }
  @media (min-width: 640px) { .hero-title { font-size: clamp(88px, 13vw, 132px); } }
  /* Od 1024px nazwa w jednej linii na całą szerokość kontenera (7,5em przy Anton). */
  @media (min-width: 1024px) { .hero-title { font-size: clamp(104px, 11.4vw, 164px); white-space: nowrap; } }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 18, 17, 0.05) 0%, rgba(18, 18, 17, 0.25) 45%, rgba(18, 18, 17, 0.88) 82%, #121211 100%);
  }
  @media (min-width: 1024px) {
    .hero-media::after {
      background:
        linear-gradient(0deg, #121211 0%, rgba(18, 18, 17, 0.82) 28%, rgba(18, 18, 17, 0.25) 62%, rgba(18, 18, 17, 0.1) 100%),
        linear-gradient(90deg, rgba(18, 18, 17, 0.35) 0%, rgba(18, 18, 17, 0) 55%);
    }
  }
  :global(.js) .hero [data-enter] { opacity: 0; }
  :global(.js) .hero [data-enter-trail] { transform: skewX(-12deg) scaleX(0); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero [data-enter] { opacity: 1; }
    :global(.js) .hero [data-enter-trail] { transform: skewX(-12deg); }
  }
</style>

<script>
  import { animate, stagger } from 'motion';

  // Wejście hero: jeden raz przy załadowaniu.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ease = [0.22, 1, 0.36, 1] as const;
    animate('.hero-media img', { scale: [1.08, 1] }, { duration: 1.6, ease });
    animate('.hero [data-enter]', { opacity: [0, 1], y: [28, 0] }, { duration: 0.75, delay: stagger(0.09, { startDelay: 0.1 }), ease });
    animate('.hero [data-enter-trail]', { transform: ['skewX(-12deg) scaleX(0)', 'skewX(-12deg) scaleX(1)'] }, { duration: 0.6, delay: 0.4, ease });
  }

  // Dni do startu, liczone w przeglądarce (HTML ma wartość z dnia budowania).
  const el = document.querySelector<HTMLElement>('[data-countdown]');
  if (el) {
    const d = Math.max(0, Math.ceil((new Date(el.dataset.countdown!).getTime() - Date.now()) / 864e5));
    el.textContent = d === 0 ? 'Dziś' : `${d} ${d === 1 ? 'dzień' : 'dni'}`;
  }
</script>
