---
// Nagłówek sekcji: tytuł i opis jeden pod drugim, przycisk (gdy jest) po prawej, na wysokości opisu.
interface Props { id: string; title: string; lead?: string }
const { id, title, lead } = Astro.props;
---

<header class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-10">
  <div class="grid gap-3">
    <h2 id={id} class="display-lg">{title}</h2>
    {lead && <p class="lead max-w-[56ch] text-muted">{lead}</p>}
  </div>
  {Astro.slots.has('default') && <div class="flex"><slot /></div>}
</header>
