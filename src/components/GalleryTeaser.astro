---
// Zapowiedź galerii na stronie głównej: kolaż pięciu zdjęć z ostatniej edycji i link do /galeria/.
import { Picture } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import SectionHead from './SectionHead.astro';
import { photo } from '../lib/photos';

// Zdjęcia z ostatniej edycji. Wszystkie lata są w galerii.
const tiles = [
  { rel: '2025/2025-07.jpg', alt: 'Zawodnik czołga się przez błotnistą kałużę', cls: 'col-span-2 row-span-2' },
  { rel: '2025/2025-05.jpg', alt: 'Zawodnicy wspinają się po błotnistym zboczu z czerwoną plandeką', cls: '' },
  { rel: '2025/2025-08.jpg', alt: 'Zawodnik wbiega na ostatnią prostą między banerami do mety', cls: '' },
  { rel: '2025/2025-12.jpg', alt: 'Zawodniczka w okularach przeciwsłonecznych odpoczywa przy bramie mety', cls: '' },
  { rel: '2025/2025-14.jpg', alt: 'Zawodniczka unosi ręce przed ścianką z napisem Jedyny taki bieg w Polsce', cls: '' },
];
---

<section id="galeria" class="defer-render section-pad bg-surface" aria-labelledby="galeria-title">
  <div class="wrap grid gap-10 lg:gap-12">
    <SectionHead id="galeria-title" title="Błoto, woda i meta" lead="Tak było na torze w ostatnim sezonie. Zdjęcia z wcześniejszych lat czekają w galerii.">
      <a href="/galeria/" class="btn btn-outline w-full sm:w-auto">Zobacz galerię zdjęć <ArrowRight aria-hidden="true" stroke-linecap="square" /></a>
    </SectionHead>

    <div class="grid auto-rows-[1fr] grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-4">
      {tiles.map((t) => (
        <a href="/galeria/" class:list={['photo-zoom block aspect-[4/3] h-full w-full', t.cls]} aria-label={`Galeria: ${t.alt}`}>
          <Picture
            src={photo(t.rel)}
            alt=""
            widths={[360, 600, 900, 1200]}
            sizes={t.cls ? '(min-width: 1024px) 620px, 100vw' : '(min-width: 1024px) 310px, 50vw'}
            formats={['avif', 'webp']}
            class="size-full object-cover"
          />
        </a>
      ))}
    </div>
  </div>
</section>
